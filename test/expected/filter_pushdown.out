-- The top-k of one scan as (id, score) rows, with pushdown on or off.
CREATE FUNCTION fp_runs_list(qry text, pred text, k int, push bool)
RETURNS TABLE (n bigint, id int, s float8) LANGUAGE plpgsql AS $$
BEGIN
    PERFORM set_config('pg_textsearch.filter_pushdown', push::text, true);
    RETURN QUERY EXECUTE format(
        'SELECT row_number() OVER (), id, s FROM '
        '(SELECT id, (body <@> to_bm25query(%L, ''fp_runs_bm25''))::float8 AS s '
        ' FROM fp_runs WHERE %s '
        ' ORDER BY body <@> to_bm25query(%L, ''fp_runs_bm25'') '
        ' LIMIT %s) t', qry, pred, qry, k);
END;
$$;
-- Parity with pushdown on and off: the same scores in the same order,
-- and the same rows above the last score, since rows tied at the cutoff
-- may differ.  Then the oracle: with k above the match count, exactly
-- the filtered rows that contain a query term.
CREATE FUNCTION fp_runs_check(qry text, pred text, k int) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
    on_s   float8[];
    off_s  float8[];
    on_id  int[];
    off_id int[];
    idx    int[];
    ora    int[];
BEGIN
    SET LOCAL enable_sort = off;
    CREATE TEMP TABLE fp_on AS SELECT * FROM fp_runs_list(qry, pred, k, true);
    CREATE TEMP TABLE fp_off AS SELECT * FROM fp_runs_list(qry, pred, k, false);
    SELECT array_agg(s ORDER BY n),
           array_agg(id ORDER BY id) FILTER (
               WHERE s < (SELECT max(s) FROM fp_on))
    INTO on_s, on_id FROM fp_on;
    SELECT array_agg(s ORDER BY n),
           array_agg(id ORDER BY id) FILTER (
               WHERE s < (SELECT max(s) FROM fp_off))
    INTO off_s, off_id FROM fp_off;
    DROP TABLE fp_on, fp_off;
    IF on_s IS DISTINCT FROM off_s OR on_id IS DISTINCT FROM off_id THEN
        RETURN format('FAIL pushed=%s %s unpushed=%s %s',
                      on_id, on_s, off_id, off_s);
    END IF;
    PERFORM set_config('pg_textsearch.filter_pushdown', 'on', true);
    EXECUTE format(
        'SELECT coalesce(array_agg(id ORDER BY id), ARRAY[]::int[]) '
        'FROM (SELECT id FROM fp_runs WHERE %s '
        '      ORDER BY body <@> to_bm25query(%L, ''fp_runs_bm25'') '
        '      LIMIT 100000) s', pred, qry)
    INTO idx;
    EXECUTE format(
        'SELECT coalesce(array_agg(id ORDER BY id), ARRAY[]::int[]) '
        'FROM fp_runs WHERE (%s) AND string_to_array(body, '' '') && '
        '      string_to_array(%L, '' '')', pred, qry)
    INTO ora;
    IF idx IS DISTINCT FROM ora THEN
        RETURN format('FAIL index=%s oracle=%s', idx, ora);
    END IF;
    RETURN format('PASS (%s of %s rows)',
                  coalesce(array_length(on_s, 1), 0),
                  coalesce(array_length(idx, 1), 0));
END;
$$;
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SELECT count(*) FROM (
    SELECT id FROM fp_runs WHERE coll = 1
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_runs_bm25') LIMIT 10) s;
