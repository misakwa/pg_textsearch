-- Updates leave the old TIDs in the segments and put new ones, inside
-- the segments' heap ranges, in the memtable: body changes in coll 1's
-- runs, and rows in the gaps moving into coll 1 and coll 3.
UPDATE fp_runs SET body = body || ' w1' WHERE coll = 1 AND id % 7 = 0;
UPDATE fp_runs SET coll = 1 WHERE id IN (3000, 3001, 15000, 20500);
UPDATE fp_runs SET coll = 3 WHERE id IN (700, 13333, 25000);
SELECT n, qry, pred, k, fp_runs_check(qry, pred, k) AS result
FROM (VALUES
    (1, 'w1',          'coll = 1',      10),
    (2, 'w1 w2 w5',    'coll = 1',    1000),
    (3, 'w6',          'coll = 3',       5),
    (4, 'w2 w9 w13',   'coll = 3',     500),
    (5, 'w3 w7 w11',   'coll = 2',     100)
) v(n, qry, pred, k)
ORDER BY n;
 n |    qry    |   pred   |  k   |         result          
---+-----------+----------+------+-------------------------
 1 | w1        | coll = 1 |   10 | PASS (10 of 86 rows)
 2 | w1 w2 w5  | coll = 1 | 1000 | PASS (154 of 154 rows)
 3 | w6        | coll = 3 |    5 | PASS (5 of 51 rows)
 4 | w2 w9 w13 | coll = 3 |  500 | PASS (130 of 130 rows)
 5 | w3 w7 w11 | coll = 2 |  100 | PASS (100 of 2342 rows)
(5 rows)

