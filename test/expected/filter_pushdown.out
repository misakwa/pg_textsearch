-- Test: filter pushdown into BM25 top-k index scans
--
-- A BM25 top-k scan with a Filter col = constant, where col leads a
-- btree of the same table, reads that btree once and scores only the
-- rows it lists (pg_textsearch.filter_pushdown).  Pushdown changes
-- which documents the scan scores, never which rows win or their
-- scores, so every check compares against the unpushed scan or an
-- independent oracle:
--   * parity   - pushdown on == off: same ids, same order, equal scores
--   * oracle   - with k above the match count, the filtered scan returns
--                exactly the filtered rows containing a query term
--   * passes   - a small filtered set needs one scoring pass
--   * sources  - two segments plus the memtable, HOT and non-HOT updates
--   * re-drive - rows lost above the scan (a join) still re-drive it
--   * density  - a sparse filter (3 rows) gallops over each segment's
--                CTID map, a dense one (10% of the table) merges with it
--   * runs     - collections stored in runs far apart merge and jump
--                the gaps; the cost rule prices the entries walked
--   * fallback - above pg_textsearch.filter_pushdown_max_rows, or where
--                pg_textsearch.filter_pushdown_cost_ratio expects ranking
--                the whole index to be cheaper (it is for a small LIMIT
--                and a large filter)
--   * RLS      - user clauses behind a policy are not pushed
--   * identity - two BM25 scans in one statement use their own filters
SET log_duration = off;
SET client_min_messages = WARNING;
CREATE EXTENSION IF NOT EXISTS pg_textsearch;
SET enable_seqscan = false;
SET enable_bitmapscan = false;
------------------------------------------------------------------------
-- Setup: 14,000 docs over 60 collections (coll = id % 60) plus three
-- small ones, words drawn from a 40-word vocabulary.  grp = 1 holds
-- every tenth doc.  Two batches are
-- spilled to segments and the third stays in the memtable.
------------------------------------------------------------------------
CREATE TABLE fp_docs (
    id    int PRIMARY KEY,
    coll  int NOT NULL,
    owner text NOT NULL,
    grp   int NOT NULL,
    body  text
) WITH (fillfactor = 50);
CREATE INDEX fp_docs_coll ON fp_docs (coll, id);
CREATE INDEX fp_docs_grp ON fp_docs (grp);
CREATE INDEX fp_docs_bm25 ON fp_docs USING bm25 (body)
    WITH (text_config = 'simple');
CREATE FUNCTION fp_body(g int) RETURNS text LANGUAGE sql IMMUTABLE AS $$
    SELECT string_agg('w' || ((hashint4(g * 16 + i) & 1023) % 40), ' ')
    FROM generate_series(1, 3 + g % 10) i
$$;
CREATE FUNCTION fp_coll(g int) RETURNS int LANGUAGE sql IMMUTABLE AS $$
    SELECT CASE WHEN g IN (5, 7001, 13001) THEN 200
                WHEN g % 97 = 0 THEN 100
                ELSE g % 60 END
$$;
INSERT INTO fp_docs
SELECT g, fp_coll(g), CASE WHEN g % 2 = 0 THEN 'fp_reader' ELSE 'other' END,
       (g % 10 = 3)::int, fp_body(g)
FROM generate_series(1, 6000) g;
SELECT bm25_spill_index('fp_docs_bm25') IS NOT NULL AS spilled;
 spilled 
---------
 t
(1 row)

INSERT INTO fp_docs
SELECT g, fp_coll(g), CASE WHEN g % 2 = 0 THEN 'fp_reader' ELSE 'other' END,
       (g % 10 = 3)::int, fp_body(g)
FROM generate_series(6001, 12000) g;
SELECT bm25_spill_index('fp_docs_bm25') IS NOT NULL AS spilled;
 spilled 
---------
 t
(1 row)

INSERT INTO fp_docs
SELECT g, fp_coll(g), CASE WHEN g % 2 = 0 THEN 'fp_reader' ELSE 'other' END,
       (g % 10 = 3)::int, fp_body(g)
FROM generate_series(12001, 14000) g;
ANALYZE fp_docs;
-- The plan under test: a BM25 index scan with the collection as Filter.
EXPLAIN (COSTS OFF)
SELECT id FROM fp_docs WHERE coll = 100
ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 10;
                          QUERY PLAN                          
--------------------------------------------------------------
 Limit
   ->  Index Scan using fp_docs_bm25 on fp_docs
         Order By: (body <@> 'fp_docs_bm25:w1 w2'::bm25query)
         Filter: (coll = 100)
(4 rows)

-- The scan reads the btree once and reports how many rows it allows.
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SELECT count(*) FROM (
    SELECT id FROM fp_docs WHERE coll = 100
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 10) s;
NOTICE:  BM25 filter pushdown: 144 rows from index "fp_docs_coll"
 count 
-------
    10
(1 row)

RESET pg_textsearch.log_filter_pushdown;
SET client_min_messages = WARNING;
------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
-- The top-k as "id:score" in result order, with pushdown on or off.
CREATE FUNCTION fp_list(qry text, pred text, k int, push bool)
RETURNS text[] LANGUAGE plpgsql AS $$
DECLARE
    r text[];
BEGIN
    PERFORM set_config('pg_textsearch.filter_pushdown', push::text, true);
    EXECUTE format(
        'SELECT coalesce(array_agg(id || '':'' || s::text ORDER BY n), '
        '                ARRAY[]::text[]) '
        'FROM (SELECT id, s, row_number() OVER () AS n FROM '
        '      (SELECT id, body <@> to_bm25query(%L, ''fp_docs_bm25'') AS s '
        '       FROM fp_docs WHERE %s '
        '       ORDER BY body <@> to_bm25query(%L, ''fp_docs_bm25'') '
        '       LIMIT %s) t) u', qry, pred, qry, k)
    INTO r;
    RETURN r;
END;
$$;
CREATE FUNCTION fp_check(qry text, pred text, k int) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
    pushed   text[];
    unpushed text[];
BEGIN
    pushed   := fp_list(qry, pred, k, true);
    unpushed := fp_list(qry, pred, k, false);
    IF pushed IS NOT DISTINCT FROM unpushed THEN
        RETURN format('PASS (%s rows)', coalesce(array_length(pushed, 1), 0));
    END IF;
    RETURN format('FAIL pushed=%s unpushed=%s', pushed, unpushed);
END;
$$;
-- The ids of the filtered scan with k above the match count, against
-- the filtered rows that contain any query term.
CREATE FUNCTION fp_oracle(qry text, pred text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
    idx int[];
    ora int[];
BEGIN
    -- Keep the BM25 scan: a btree scan plus Sort would score every row.
    SET LOCAL enable_sort = off;
    EXECUTE format(
        'SELECT coalesce(array_agg(id ORDER BY id), ARRAY[]::int[]) '
        'FROM (SELECT id FROM fp_docs WHERE %s '
        '      ORDER BY body <@> to_bm25query(%L, ''fp_docs_bm25'') '
        '      LIMIT 100000) s', pred, qry)
    INTO idx;
    EXECUTE format(
        'SELECT coalesce(array_agg(id ORDER BY id), ARRAY[]::int[]) '
        'FROM fp_docs WHERE (%s) AND string_to_array(body, '' '') && '
        '      string_to_array(%L, '' '')', pred, qry)
    INTO ora;
    IF idx IS NOT DISTINCT FROM ora THEN
        RETURN format('PASS (%s rows)', coalesce(array_length(idx, 1), 0));
    END IF;
    RETURN format('FAIL index=%s oracle=%s', idx, ora);
END;
$$;
-- Scoring passes of one filtered top-k with pushdown on.
CREATE FUNCTION fp_passes(qry text, pred text, k int) RETURNS bigint
LANGUAGE plpgsql AS $$
BEGIN
    PERFORM bm25_debug_scoring_passes(true);
    PERFORM fp_list(qry, pred, k, true);
    RETURN bm25_debug_scoring_passes(true);
END;
$$;
------------------------------------------------------------------------
-- Parity and oracle over single- and multi-term queries
------------------------------------------------------------------------
SELECT n, qry, pred, k, fp_check(qry, pred, k) AS result
FROM (VALUES
    (1,  'w1',             'coll = 100',          10),
    (2,  'w1 w2',          'coll = 100',          10),
    (3,  'w3 w7 w11',      'coll = 100',          50),
    (4,  'w3 w7 w11 w19',  'coll = 7',            10),
    (5,  'w5',             'coll = 7',           300),
    (6,  'w0 w1 w2 w3 w4', 'coll = 200',          10),
    (7,  'w2 w9',          '100 = coll',          10),
    (8,  'w2 w9',          'coll = 100::bigint',  10),
    (9,  'w2 w9',          'coll = 100 AND id % 3 = 0', 10),
    (10, 'w39 w38',        'coll = 12',            1),
    (11, 'w4 w8',          'coll = 999',          10),
    (12, 'w1 w2',          'coll IN (7, 100)',    10)
) v(n, qry, pred, k)
ORDER BY n;
 n  |      qry       |           pred            |  k  |     result      
----+----------------+---------------------------+-----+-----------------
  1 | w1             | coll = 100                |  10 | PASS (10 rows)
  2 | w1 w2          | coll = 100                |  10 | PASS (10 rows)
  3 | w3 w7 w11      | coll = 100                |  50 | PASS (50 rows)
  4 | w3 w7 w11 w19  | coll = 7                  |  10 | PASS (10 rows)
  5 | w5             | coll = 7                  | 300 | PASS (232 rows)
  6 | w0 w1 w2 w3 w4 | coll = 200                |  10 | PASS (3 rows)
  7 | w2 w9          | 100 = coll                |  10 | PASS (10 rows)
  8 | w2 w9          | coll = 100::bigint        |  10 | PASS (10 rows)
  9 | w2 w9          | coll = 100 AND id % 3 = 0 |  10 | PASS (10 rows)
 10 | w39 w38        | coll = 12                 |   1 | PASS (1 rows)
 11 | w4 w8          | coll = 999                |  10 | PASS (0 rows)
 12 | w1 w2          | coll IN (7, 100)          |  10 | PASS (10 rows)
(12 rows)

SELECT n, qry, pred, fp_oracle(qry, pred) AS result
FROM (VALUES
    (1, 'w1',             'coll = 100'),
    (2, 'w1 w2 w3',       'coll = 100'),
    (3, 'w6 w17',         'coll = 31'),
    (4, 'w0 w1 w2 w3 w4', 'coll = 200'),
    (5, 'w12',            'coll = 59')
) v(n, qry, pred)
ORDER BY n;
 n |      qry       |    pred    |     result     
---+----------------+------------+----------------
 1 | w1             | coll = 100 | PASS (22 rows)
 2 | w1 w2 w3       | coll = 100 | PASS (59 rows)
 3 | w6 w17         | coll = 31  | PASS (57 rows)
 4 | w0 w1 w2 w3 w4 | coll = 200 | PASS (1 rows)
 5 | w12            | coll = 59  | PASS (53 rows)
(5 rows)

------------------------------------------------------------------------
-- Density: the 3-row filter above gallops; grp = 1 covers 10% of each
-- segment and merges with its CTID map.  Equal scores tied across the
-- cutoff may resolve to different rows with and without pushdown, so k
-- stops at a score boundary.
------------------------------------------------------------------------
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SELECT count(*) FROM (
    SELECT id FROM fp_docs WHERE grp = 1
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 10) s;
NOTICE:  BM25 filter pushdown: 1400 rows from index "fp_docs_grp"
 count 
-------
    10
(1 row)

RESET pg_textsearch.log_filter_pushdown;
SET client_min_messages = WARNING;
SELECT n, qry, pred, k, fp_check(qry, pred, k) AS result
FROM (VALUES
    (1, 'w1',            'grp = 1',               8),
    (2, 'w3 w7 w11',     'grp = 1',              50),
    (3, 'w3 w7 w11 w19', 'grp = 1',            1500),
    (4, 'w2 w9',         'grp = 1 AND coll = 13', 10)
) v(n, qry, pred, k)
ORDER BY n;
 n |      qry      |         pred          |  k   |      result      
---+---------------+-----------------------+------+------------------
 1 | w1            | grp = 1               |    8 | PASS (8 rows)
 2 | w3 w7 w11     | grp = 1               |   50 | PASS (50 rows)
 3 | w3 w7 w11 w19 | grp = 1               | 1500 | PASS (1400 rows)
 4 | w2 w9         | grp = 1 AND coll = 13 |   10 | PASS (10 rows)
(4 rows)

SELECT n, qry, pred, fp_oracle(qry, pred) AS result
FROM (VALUES
    (1, 'w1 w2',  'grp = 1'),
    (2, 'w5 w30', 'grp = 1')
) v(n, qry, pred)
ORDER BY n;
 n |  qry   |  pred   |     result      
---+--------+---------+-----------------
 1 | w1 w2  | grp = 1 | PASS (374 rows)
 2 | w5 w30 | grp = 1 | PASS (353 rows)
(2 rows)

-- One scoring pass when the filtered set is smaller than the batch.
SELECT fp_passes('w1 w2 w3', 'coll = 100', 10) AS passes_small,
       fp_passes('w1 w2 w3', 'coll = 7', 10) AS passes_collection;
 passes_small | passes_collection 
--------------+-------------------
            1 |                 1
(1 row)

------------------------------------------------------------------------
-- Updates: HOT (unindexed column) and non-HOT (collection moves)
------------------------------------------------------------------------
UPDATE fp_docs SET owner = owner || '_x' WHERE coll = 100 AND id % 2 = 0;
UPDATE fp_docs SET coll = 7 WHERE coll = 100 AND id % 3 = 0;
UPDATE fp_docs SET body = body || ' w1' WHERE coll = 100 AND id % 5 = 0;
SELECT n, qry, pred, k, fp_check(qry, pred, k) AS result
FROM (VALUES
    (1, 'w1',       'coll = 100', 10),
    (2, 'w1 w2',    'coll = 100', 20),
    (3, 'w1 w2',    'coll = 7',   20)
) v(n, qry, pred, k)
ORDER BY n;
 n |  qry  |    pred    | k  |     result     
---+-------+------------+----+----------------
 1 | w1    | coll = 100 | 10 | PASS (10 rows)
 2 | w1 w2 | coll = 100 | 20 | PASS (20 rows)
 3 | w1 w2 | coll = 7   | 20 | PASS (20 rows)
(3 rows)

SELECT n, qry, pred, fp_oracle(qry, pred) AS result
FROM (VALUES
    (1, 'w1',    'coll = 100'),
    (2, 'w1 w2', 'coll = 7')
) v(n, qry, pred)
ORDER BY n;
 n |  qry  |    pred    |     result      
---+-------+------------+-----------------
 1 | w1    | coll = 100 | PASS (31 rows)
 2 | w1 w2 | coll = 7   | PASS (118 rows)
(2 rows)

------------------------------------------------------------------------
-- Re-drive: a join between the Limit and the scan drops rows, so the
-- scan must return more than its first batch.  default_limit 5 forces
-- the re-drive with pushdown active.
------------------------------------------------------------------------
CREATE TABLE fp_acl (id int PRIMARY KEY, ok bool NOT NULL);
INSERT INTO fp_acl SELECT id, id % 4 = 0 FROM fp_docs;
ANALYZE fp_acl;
CREATE FUNCTION fp_acl_list(push bool) RETURNS int[] LANGUAGE plpgsql AS $$
DECLARE
    r int[];
BEGIN
    PERFORM set_config('pg_textsearch.filter_pushdown', push::text, true);
    SELECT array_agg(id ORDER BY n) INTO r FROM (
        SELECT id, row_number() OVER () AS n FROM (
            SELECT d.id FROM fp_docs d
            WHERE d.coll = 7
              AND EXISTS (SELECT 1 FROM fp_acl a WHERE a.id = d.id AND a.ok)
            ORDER BY d.body <@> to_bm25query('w1 w2', 'fp_docs_bm25'), d.id
            LIMIT 30) t) u;
    RETURN r;
END;
$$;
SET pg_textsearch.default_limit = 5;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SELECT fp_acl_list(true) = fp_acl_list(false) AS acl_parity,
       array_length(fp_acl_list(true), 1) AS acl_rows;
 acl_parity | acl_rows 
------------+----------
 t          |        2
(1 row)

SELECT bm25_debug_scoring_passes(true) >= 0 AS reset;
 reset 
-------
 t
(1 row)

SELECT array_length(fp_acl_list(true), 1) AS rows,
       bm25_debug_scoring_passes(true) > 1 AS redriven;
 rows | redriven 
------+----------
    2 | t
(1 row)

RESET enable_hashjoin;
RESET enable_mergejoin;
RESET pg_textsearch.default_limit;
------------------------------------------------------------------------
-- Fallback above filter_pushdown_max_rows (planned and executed)
------------------------------------------------------------------------
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SET pg_textsearch.filter_pushdown_max_rows = 100;
SELECT count(*) FROM (
    SELECT id FROM fp_docs WHERE coll = 7
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 10) s;
 count 
-------
    10
(1 row)

RESET pg_textsearch.log_filter_pushdown;
SET client_min_messages = WARNING;
SELECT fp_check('w1 w2', 'coll = 7', 10) AS capped;
     capped     
----------------
 PASS (10 rows)
(1 row)

-- A plan made under a larger cap still falls back at execution.
SET plan_cache_mode = force_generic_plan;
PREPARE fp_q AS
    SELECT count(*) FROM (
        SELECT id FROM fp_docs WHERE coll = 7
        ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 10) s;
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SET pg_textsearch.filter_pushdown_max_rows = 100000;
EXECUTE fp_q;
NOTICE:  BM25 filter pushdown: 280 rows from index "fp_docs_coll"
 count 
-------
    10
(1 row)

SET pg_textsearch.filter_pushdown_max_rows = 100;
EXECUTE fp_q;
NOTICE:  BM25 filter pushdown not used (estimated 232 rows, limit 100 of 14000 table rows)
 count 
-------
    10
(1 row)

RESET pg_textsearch.log_filter_pushdown;
SET client_min_messages = WARNING;
DEALLOCATE fp_q;
RESET plan_cache_mode;
RESET pg_textsearch.filter_pushdown_max_rows;
------------------------------------------------------------------------
-- Fallback by cost.  grp = 1 is 1,400 of 14,000 rows spread over the
-- whole table, though ANALYZE reports grp's correlation as 0.82, so the
-- estimate takes them for partly clustered.  LIMIT 10 keeps pushdown.
-- LIMIT 1 falls back on the estimate, before the btree read.  At LIMIT 2
-- the estimate passes, but the rows read span the whole table and a
-- seeded scan finishes in one pass, so it falls back after the read;
-- without the seed the scan would re-drive, and pushdown stays.  A
-- generic plan made under the default ratio falls back at execution
-- under a tiny one.
------------------------------------------------------------------------
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SELECT count(*) FROM (
    SELECT id FROM fp_docs WHERE grp = 1
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 10) s;
NOTICE:  BM25 filter pushdown: 1405 rows from index "fp_docs_grp"
 count 
-------
    10
(1 row)

SELECT count(*) FROM (
    SELECT id FROM fp_docs WHERE grp = 1
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 1) s;
NOTICE:  BM25 filter pushdown not used (estimated 1400 rows, limit 991 of 14000 table rows)
 count 
-------
     1
(1 row)

SELECT count(*) FROM (
    SELECT id FROM fp_docs WHERE grp = 1
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 2) s;
NOTICE:  BM25 filter pushdown not used (1405 rows walking about 14000 of 14000 table rows)
 count 
-------
     2
(1 row)

SET pg_textsearch.filtered_seed = off;
SELECT count(*) FROM (
    SELECT id FROM fp_docs WHERE grp = 1
    ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 2) s;
NOTICE:  BM25 filter pushdown: 1405 rows from index "fp_docs_grp"
 count 
-------
     2
(1 row)

RESET pg_textsearch.filtered_seed;
SET client_min_messages = WARNING;
SELECT fp_check('w1 w2', 'grp = 1', 1) AS cost_fallback;
 cost_fallback 
---------------
 PASS (1 rows)
(1 row)

SET plan_cache_mode = force_generic_plan;
PREPARE fp_g AS
    SELECT count(*) FROM (
        SELECT id FROM fp_docs WHERE coll = 7
        ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25') LIMIT 10) s;
SET client_min_messages = NOTICE;
EXECUTE fp_g;
NOTICE:  BM25 filter pushdown: 280 rows from index "fp_docs_coll"
 count 
-------
    10
(1 row)

SET pg_textsearch.filter_pushdown_cost_ratio = 0.01;
EXECUTE fp_g;
NOTICE:  BM25 filter pushdown not used (estimated 232 rows, limit 1 of 14000 table rows)
 count 
-------
    10
(1 row)

RESET pg_textsearch.log_filter_pushdown;
SET client_min_messages = WARNING;
DEALLOCATE fp_g;
RESET plan_cache_mode;
RESET pg_textsearch.filter_pushdown_cost_ratio;
------------------------------------------------------------------------
-- RLS: under a policy the user's clause carries a security level and
-- is not pushed; results equal the oracle restricted to the policy.
------------------------------------------------------------------------
CREATE ROLE fp_reader;
GRANT SELECT ON fp_docs TO fp_reader;
GRANT USAGE ON SCHEMA public TO fp_reader;
ALTER TABLE fp_docs ENABLE ROW LEVEL SECURITY;
CREATE POLICY fp_own ON fp_docs USING (owner = current_user);
SET ROLE fp_reader;
SET enable_sort = off;
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SELECT count(*) AS rls_rows,
       array_agg(id ORDER BY id) IS NOT DISTINCT FROM (
           SELECT array_agg(id ORDER BY id) FROM fp_docs
           WHERE coll = 8 AND string_to_array(body, ' ') && ARRAY['w1', 'w2'])
       AS rls_oracle
FROM (SELECT id FROM fp_docs WHERE coll = 8
      ORDER BY body <@> to_bm25query('w1 w2', 'fp_docs_bm25')
      LIMIT 100000) s;
 rls_rows | rls_oracle 
----------+------------
      105 | t
(1 row)

RESET pg_textsearch.log_filter_pushdown;
SET client_min_messages = WARNING;
RESET enable_sort;
RESET ROLE;
ALTER TABLE fp_docs DISABLE ROW LEVEL SECURITY;
DROP POLICY fp_own ON fp_docs;
REVOKE ALL ON fp_docs FROM fp_reader;
REVOKE USAGE ON SCHEMA public FROM fp_reader;
DROP ROLE fp_reader;
------------------------------------------------------------------------
-- Scan identity: two BM25 scans in one statement, each with its own
-- filter.
------------------------------------------------------------------------
SET enable_sort = off;
SET client_min_messages = NOTICE;
SET pg_textsearch.log_filter_pushdown = on;
SELECT coll, count(*) FROM (
    (SELECT coll, id FROM fp_docs WHERE coll = 100
     ORDER BY body <@> to_bm25query('w3', 'fp_docs_bm25') LIMIT 1000)
    UNION ALL
    (SELECT coll, id FROM fp_docs WHERE coll = 200
     ORDER BY body <@> to_bm25query('w0 w1 w2 w3 w4', 'fp_docs_bm25')
     LIMIT 1000)) s
GROUP BY coll ORDER BY coll;
NOTICE:  BM25 filter pushdown: 96 rows from index "fp_docs_coll"
NOTICE:  BM25 filter pushdown: 3 rows from index "fp_docs_coll"
 coll | count 
------+-------
  100 |    14
  200 |     1
(2 rows)

RESET pg_textsearch.log_filter_pushdown;
SET client_min_messages = WARNING;
SELECT (SELECT count(*) FROM (
            SELECT id FROM fp_docs WHERE coll = 100
            ORDER BY body <@> to_bm25query('w3', 'fp_docs_bm25')
            LIMIT 1000) s) = (SELECT count(*) FROM fp_docs
                              WHERE coll = 100
                                AND string_to_array(body, ' ') && ARRAY['w3'])
       AS first_scan,
       (SELECT count(*) FROM (
            SELECT id FROM fp_docs WHERE coll = 200
            ORDER BY body <@> to_bm25query('w0 w1 w2 w3 w4', 'fp_docs_bm25')
            LIMIT 1000) s) = (SELECT count(*) FROM fp_docs
                              WHERE coll = 200
                                AND string_to_array(body, ' ') &&
                                    ARRAY['w0', 'w1', 'w2', 'w3', 'w4'])
       AS second_scan;
 first_scan | second_scan 
------------+-------------
 t          | t
(1 row)

RESET enable_sort;
------------------------------------------------------------------------
-- Runs: collections stored in runs separated by thousands of other rows,
-- in two segments plus the memtable.  The merge jumps over each gap
-- with a search instead of walking it, and the cost rule prices the
-- entries walked rather than the first-to-last span.  coll 1 has runs
-- of 40 rows about 4,000 apart; coll 2 a run of 1,800 and one of 100
-- after a gap of 1,500, inside one bulk read; coll 3 runs of 20 about
-- 1,500 apart; the rest are 50 scattered collections.  tag = 0 marks
-- coll 1's original rows, and its other values rise along the heap, so
-- ANALYZE takes tag = 0 for clustered.
------------------------------------------------------------------------
CREATE TABLE fp_runs (
    id   int PRIMARY KEY,
    coll int NOT NULL,
    tag  int NOT NULL,
    body text
) WITH (fillfactor = 70);
CREATE INDEX fp_runs_coll ON fp_runs (coll);
CREATE INDEX fp_runs_tag ON fp_runs (tag);
CREATE INDEX fp_runs_bm25 ON fp_runs USING bm25 (body)
    WITH (text_config = 'simple');
CREATE FUNCTION fp_runs_coll(g int) RETURNS int LANGUAGE sql IMMUTABLE AS $$
    SELECT CASE WHEN g % 12000 BETWEEN 1000 AND 1039
                  OR g % 12000 BETWEEN 5000 AND 5039
                  OR g % 12000 BETWEEN 9000 AND 9039 THEN 1
                WHEN g % 12000 BETWEEN 2000 AND 3799
                  OR g % 12000 BETWEEN 5300 AND 5399 THEN 2
                WHEN g % 1500 < 20 THEN 3
                ELSE 100 + g % 50 END
$$;
CREATE FUNCTION fp_runs_load(lo int, hi int) RETURNS void
LANGUAGE sql AS $$
    INSERT INTO fp_runs
    SELECT g, fp_runs_coll(g),
           CASE WHEN fp_runs_coll(g) = 1 THEN 0 ELSE 1 + g / 100 END,
           fp_body(g)
    FROM generate_series(lo, hi) g
$$;
