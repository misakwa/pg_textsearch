    (8,  'w2 w9 w13',     'coll = 3',     500),
    (9,  'w1 w2',         'coll = 117',    20),
    (10, 'w1 w2 w3',      'tag = 0',     1000)
) v(n, qry, pred, k)
ORDER BY n;
