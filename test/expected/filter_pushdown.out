    (5,  'zr',          'coll = 7',                 10),
    (6,  'zr loan',     'coll = 0',                  3),
    (7,  'm3 m7',       'coll = 0',               3000),
    (8,  'loan m3',     'lang = ''en''',            10),
    (9,  'l4 l9',       'lang = ''en''',           100),
    (10, 'loan m3',     'tenant = 1',               10),
    (11, 'zr',          'lang = ''en''',            10)
) v(n, qry, pred, k)
ORDER BY n;
